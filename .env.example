# ==========================================
# AAA TECH SOLUTIONS - Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (MySQL / TiDB Cloud)
# Option A: Local MySQL
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=aaa_tech_solutions
# DB_SSL=false

# Option B: TiDB Cloud Serverless / Dedicated
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=aaa_tech_solutions
DB_SSL=true

# JWT Authentication Secret (Use a secure random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Default Administrator Credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=your_admin_password_here
